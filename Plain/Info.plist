<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- A browser opens http pages too. Only web content is exempt; the app's own requests
		     (search suggestions) stay on ATS. HTTPS upgrade is on (FixedChoices). -->
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- Web links: Apple's first requirement for the default-browser entitlement. Until Apple grants
	     it, iOS routes no http or https link here (docs/research/sign-in.md). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>Web site URL</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
		<!-- Plain's own links: the widgets open search, a favorite or a tab with them
		     (PlainShared.PlainLink). Each does only what a tap in Plain does. Plain Dev's scheme is
		     plainbrowser.dev, so its widgets never open the TestFlight app (or the reverse). -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>Plain link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>plainbrowser$(PLAIN_BUNDLE_SUFFIX)</string>
			</array>
		</dict>
	</array>
	<!-- Handoff: web pages continued from another device. iOS sends them to the default browser,
	     so they reach Plain once it can be the default (docs/research/system-integration.md).
	     "Open in New Window" asks for a scene with Plain's window activity (ShellUI's Windows). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>NSUserActivityTypeBrowsingWeb</string>
		<string>dev.abrahamgonzalez.plainbrowser.window</string>
	</array>
	<!-- The App Group and the link scheme, from project.yml (they follow the bundle suffix):
	     PlainShared.AppGroup and PlainLink read them. -->
	<key>PlainAppGroup</key>
	<string>$(PLAIN_APP_GROUP)</string>
	<key>PlainLinkScheme</key>
	<string>plainbrowser$(PLAIN_BUNDLE_SUFFIX)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Downloads go to Documents/Downloads; these two make it Plain's folder in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Asked only when a site needs them; Plain then remembers each site's answer. -->
	<key>NSCameraUsageDescription</key>
	<string>Websites you allow can use the camera, for video calls and photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Websites you allow can use the microphone, for calls and voice. The microphone in the search field turns what you say into text on your phone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>The microphone in the search field turns what you say into text. It happens on your phone; nothing you say is sent anywhere.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Websites you allow can see your location, for maps and places nearby.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Images you save from websites go to your photo library.</string>
	<!-- Windows: the iPhone Duo's inner screen and iPad-size windows take more than one
	     (docs/decisions.md, "Open in New Window"). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Audio, AirPlay and Picture in Picture, as Safari has them: a page's sound goes on with the
	     screen locked or in another app, a fullscreen video moves to picture in picture when the
	     user leaves, and lock-screen controls work. WebKit sets the audio session itself and
	     pauses a video (not in PiP or AirPlay) when the app leaves the screen
	     (docs/research/media-playback.md). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
