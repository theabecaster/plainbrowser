<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App Group the app writes the favorites file into (PlainShared.AppGroup). Same as the app's
     (PLAIN_APP_GROUP in project.yml, which follows the bundle suffix). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(PLAIN_APP_GROUP)</string>
	</array>
</dict>
</plist>
