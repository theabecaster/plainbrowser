# Copy to scripts/local.env (gitignored) and fill in. The environment wins over this file.
# The iPhone the device scripts build for, install on and measure (Xcode > Devices, or
# `xcrun devicectl list devices`).
PLAIN_DEVICE=00000000-0000000000000000

# TestFlight (scripts/testflight.sh). An App Store Connect API key with the App Manager role:
# its id, its issuer id, and the .p8 file (default ~/.appstoreconnect/private_keys/AuthKey_<id>.p8).
ASC_KEY_ID=
ASC_ISS=
# ASC_KEY=
# The app's App Store Connect id and the beta group each build goes to.
TESTFLIGHT_APP_ID=
TESTFLIGHT_GROUP_ID=
